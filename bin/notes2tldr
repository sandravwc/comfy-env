#!/usr/bin/env python3
"""Generate tealdeer patch pages from a Foam/markdown notes vault.

tldr's own pages stay untouched: for every `cheat sheet/<name>.md` whose name
matches an official tldr page, this writes `<name>.patch.md`, which tealdeer
appends below the upstream examples.

  notes2tldr                 write patches
  notes2tldr --dry-run       show what would be written
  notes2tldr --list          show which notes match an official page
  notes2tldr --force         overwrite hand-written patches too

Vault path comes from $FOAM_VAULT (set it in ~/.bashrc).

Vault bullets map straight onto tldr examples:

    - resize disk           ->   - resize disk:
      ```sh
      lvextend -L +10G ...  ->   `lvextend -L +10G ...`
      ```

Backslash continuations are joined into one line, because a tldr example must
be a single command; a `#` comment above a command is folded into its
description.
"""
import os
import re
import sys

VAULT = os.environ.get("FOAM_VAULT", "")
SUBDIR = "cheat sheet"
CACHE = os.path.expanduser("~/.cache/tealdeer/tldr-pages")
OUT = os.path.expanduser("~/.local/share/tealdeer/pages")
MARK = "<!-- generated by notes2tldr, edits will be lost -->"


def official_pages():
    names = set()
    for root, _, files in os.walk(CACHE):
        for f in files:
            if f.endswith(".md"):
                names.add(f[:-3])
    return names


def parse(path):
    """-> [(description, command)] from `- label` bullets with fenced blocks."""
    out = []
    label = None
    in_block = False
    pending_comment = None
    buf = ""

    for raw in open(path, errors="replace"):
        line = raw.rstrip("\n")

        if not in_block:
            m = re.match(r"^- (.+?):?\s*$", line)
            if m:
                label = m.group(1).strip()
                continue
            if re.match(r"^\s*```", line) and label:
                in_block = True
                pending_comment = None
                buf = ""
            continue

        if re.match(r"^\s*```\s*$", line):
            in_block = False
            continue

        body = line.strip()
        if not body:
            continue
        if body.startswith("#"):
            pending_comment = body.lstrip("# ").strip()
            continue

        # join backslash continuations
        buf = (buf + " " + body).strip() if buf else body
        if buf.endswith("\\"):
            buf = buf[:-1].rstrip()
            continue

        desc = label
        if pending_comment:
            desc = f"{label} — {pending_comment}"
        out.append((desc, " ".join(buf.split())))
        buf = ""
        pending_comment = None

    return out


def render(name, examples):
    lines = [MARK, "", f"- from notes: {SUBDIR}/{name}", ""]
    for desc, cmd in examples:
        if "`" in cmd:  # backticks would break the fence
            continue
        lines.append(f"- {desc.rstrip(':')}:")
        lines.append("")
        lines.append(f"`{cmd}`")
        lines.append("")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help", "help") for a in args):
        print(__doc__.strip())
        return
    known = {"--dry-run", "--force", "--list"}
    unknown = [a for a in args if a not in known]
    if unknown:
        sys.exit(f"unknown option(s): {' '.join(unknown)}; --help for usage")
    dry = "--dry-run" in args
    force = "--force" in args
    listing = "--list" in args

    if not VAULT:
        sys.exit("FOAM_VAULT is not set; export it in ~/.bashrc, "
                 "e.g. export FOAM_VAULT=\"$HOME/workdir/notes\"")

    pages = official_pages()
    if not pages:
        sys.exit(f"no tldr cache at {CACHE}; run `tldr --update` first")

    src = os.path.join(VAULT, SUBDIR)
    if not os.path.isdir(src):
        sys.exit(f"no {src}")

    os.makedirs(OUT, exist_ok=True)
    written = skipped = 0

    for f in sorted(os.listdir(src)):
        if not f.endswith(".md"):
            continue
        name = f[:-3]
        if name not in pages:
            if listing:
                print(f"  --   {name} (no official page)")
            continue

        examples = parse(os.path.join(src, f))
        if listing:
            print(f"  ok   {name}: {len(examples)} example(s)")
            continue
        if not examples:
            continue

        dest = os.path.join(OUT, f"{name}.patch.md")
        if os.path.exists(dest) and not force:
            head = open(dest, errors="replace").readline().strip()
            if head != MARK:
                print(f"skip {name}.patch.md (hand written, --force to replace)")
                skipped += 1
                continue

        body = render(name, examples)
        if dry:
            print(f"--- {dest}\n{body}")
        else:
            with open(dest, "w") as fh:
                fh.write(body)
            print(f"wrote {name}.patch.md ({len(examples)} example(s))")
        written += 1

    if not listing:
        verb = "would write" if dry else "wrote"
        print(f"\n{verb} {written} patch page(s)"
              + (f", skipped {skipped} hand written" if skipped else ""))


if __name__ == "__main__":
    main()
