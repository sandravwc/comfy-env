#!/usr/bin/env python3
"""Generate tealdeer patch pages from a Foam/markdown notes vault.

tldr's own pages stay untouched: for every `cheat sheet/<name>.md` whose name
matches an official tldr page, this writes `<name>.patch.md`, which tealdeer
appends below the upstream examples.

  notes2tldr                 write patches
  notes2tldr --dry-run       show what would be written
  notes2tldr --list          show which notes match an official page
  notes2tldr --force         overwrite hand-written patches too

Vault path comes from $FOAM_VAULT (set it in ~/.bashrc). The tldr cache and
custom pages directories come from `tldr --show-paths`, so tealdeer's own
config and $TEALDEER_CACHE_DIR / $TEALDEER_CONFIG_DIR are respected.

Vault bullets map straight onto tldr examples:

    - resize disk           ->   - resize disk:
      ```sh
      lvextend -L +10G ...  ->   `lvextend -L +10G ...`
      ```

Backslash continuations are joined into one line, because a tldr example must
be a single command; a `#` comment above a command is folded into its
description.
"""
import os
import re
import shlex
import subprocess
import sys

VAULT = os.environ.get("FOAM_VAULT", "")
SUBDIR = "cheat sheet"


def tealdeer_paths():
    """Ask tealdeer where its pages live, so its config and env vars win."""
    cache = os.path.expanduser("~/.cache/tealdeer/tldr-pages")
    out = os.path.expanduser("~/.local/share/tealdeer/pages")
    try:
        p = subprocess.run(["tldr", "--show-paths"], capture_output=True,
                           text=True, timeout=10)
        for line in p.stdout.splitlines():
            key, _, val = line.partition(":")
            val = val.split(" (")[0].strip().rstrip("/")
            if not val:
                continue
            if key.strip() == "Pages dir":
                cache = val
            elif key.strip() == "Custom pages dir":
                out = val
    except (OSError, subprocess.SubprocessError):
        pass
    return cache, out


CACHE, OUT = tealdeer_paths()
MARK = "<!-- generated by notes2tldr, edits will be lost -->"


def official_pages():
    names = set()
    for root, _, files in os.walk(CACHE):
        for f in files:
            if f.endswith(".md"):
                names.add(f[:-3])
    return names


def balanced(text):
    """True when quotes are closed and braces match: a complete command."""
    try:
        lex = shlex.shlex(text, posix=True)
        lex.whitespace_split = True
        list(lex)
    except ValueError:
        return False
    return text.count("{") == text.count("}")


SHELL_FENCES = ("", "sh", "bash", "shell", "console")


def blocks(path):
    """-> [(label, lang, [lines])] for every fenced block under a `- ` bullet."""
    out = []
    label = None
    lang = None
    body = None

    for raw in open(path, errors="replace"):
        line = raw.rstrip("\n")
        if body is None:
            m = re.match(r"^- (.+?):?\s*$", line)
            if m:
                label = m.group(1).strip()
                continue
            m = re.match(r"^\s*```([a-zA-Z]*)\s*$", line)
            if m and label:
                lang, body = m.group(1).lower(), []
            continue
        if re.match(r"^\s*```\s*$", line):
            out.append((label, lang, body))
            body = None
            continue
        body.append(line)

    return out


def examples_from(label, lines):
    """-> [(description, command)] or [] when the block is not a command list.

    A tldr example is one command, so a block holding a multi-line program (an
    awk or jq script, a shell loop) is dropped whole rather than shredded into
    one bogus example per line. It stays readable in the notes instead.
    """
    # `$ cmd` anywhere means an interactive transcript: the unprompted lines
    # are that command's output, not commands of their own.
    transcript = any(l.strip().startswith("$ ") for l in lines)
    if transcript:
        lines = [l.strip()[2:] for l in lines if l.strip().startswith("$ ")]

    out = []
    buf = ""
    folded = 0
    comment = None

    for line in lines:
        body = line.strip()
        if not body:
            continue
        if body.startswith("#"):
            if not buf:
                comment = body.lstrip("# ").strip()
            continue

        # unprompted command output, e.g. `/dev/mapper/x: UUID="..." TYPE=...`
        # no command's first word ends in a colon
        if not buf and body.split()[0].endswith(":"):
            continue

        if buf.endswith("\\"):
            buf = buf[:-1].rstrip() + " " + body
        elif buf:
            buf += " " + body
            folded += 1
        else:
            buf = body

        if buf.endswith("\\"):
            continue
        if not balanced(buf):
            folded += 1
            if folded > 4:
                return []          # a program, not a command
            continue
        if folded:
            return []              # needed several plain lines: a program

        desc = f"{label} — {comment}" if comment else label
        out.append((desc, " ".join(buf.split())))
        buf = ""
        folded = 0
        comment = None

    return [] if buf else out


def parse(path):
    out = []
    for label, lang, lines in blocks(path):
        if lang not in SHELL_FENCES:
            continue
        out.extend(examples_from(label, lines))
    return out


def render(name, examples):
    lines = [MARK, "", f"- from notes: {SUBDIR}/{name}", ""]
    for desc, cmd in examples:
        if "`" in cmd:  # backticks would break the fence
            continue
        lines.append(f"- {desc.rstrip(':')}:")
        lines.append("")
        lines.append(f"`{cmd}`")
        lines.append("")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help", "help") for a in args):
        print(__doc__.strip())
        return
    known = {"--dry-run", "--force", "--list"}
    unknown = [a for a in args if a not in known]
    if unknown:
        sys.exit(f"unknown option(s): {' '.join(unknown)}; --help for usage")
    dry = "--dry-run" in args
    force = "--force" in args
    listing = "--list" in args

    if not VAULT:
        sys.exit("FOAM_VAULT is not set; export it in ~/.bashrc, "
                 "e.g. export FOAM_VAULT=\"$HOME/workdir/notes\"")

    pages = official_pages()
    if not pages:
        sys.exit(f"no tldr cache at {CACHE}; run `tldr --update` first")

    src = os.path.join(VAULT, SUBDIR)
    if not os.path.isdir(src):
        sys.exit(f"no {src}")

    os.makedirs(OUT, exist_ok=True)
    written = skipped = 0

    for f in sorted(os.listdir(src)):
        if not f.endswith(".md"):
            continue
        name = f[:-3]
        if name not in pages:
            if listing:
                print(f"  --   {name} (no official page)")
            continue

        examples = parse(os.path.join(src, f))
        if listing:
            print(f"  ok   {name}: {len(examples)} example(s)")
            continue
        if not examples:
            continue

        dest = os.path.join(OUT, f"{name}.patch.md")
        if os.path.exists(dest) and not force:
            head = open(dest, errors="replace").readline().strip()
            if head != MARK:
                print(f"skip {name}.patch.md (hand written, --force to replace)")
                skipped += 1
                continue

        body = render(name, examples)
        if dry:
            print(f"--- {dest}\n{body}")
        else:
            with open(dest, "w") as fh:
                fh.write(body)
            print(f"wrote {name}.patch.md ({len(examples)} example(s))")
        written += 1

    if not listing:
        verb = "would write" if dry else "wrote"
        print(f"\n{verb} {written} patch page(s)"
              + (f", skipped {skipped} hand written" if skipped else ""))


if __name__ == "__main__":
    main()
